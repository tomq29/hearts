# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hearts

# App Database Connection
HEARTS_DATABASE_URL=postgres://postgres:change_me@postgres:5432/hearts?sslmode=disable

# MinIO (Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
HEARTS_STORAGE_ACCESS_KEY_ID=minioadmin
HEARTS_STORAGE_SECRET_ACCESS_KEY=change_me

# Auth
JWT_SECRET_KEY=change_me_to_random_string

# Kafka
# Use kafka:29092 for inter-container communication
# Comma-separated for multiple brokers
KAFKA_BROKERS=kafka:29092

# CORS: browser origins allowed to call the API with credentials
# (comma-separated). Defaults to the Vite dev/preview origins.
# HEARTS_SERVER_CORS_ALLOWED_ORIGINS=https://hearts.example.com

# Browser origins allowed to open a notification-service WebSocket
# (comma-separated). Defaults to the Vite dev/preview origins.
# CORS_ALLOWED_ORIGINS=https://hearts.example.com
